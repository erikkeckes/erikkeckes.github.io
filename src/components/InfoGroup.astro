---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div class="group">
	<h2>{title}</h2>
	<slot />
</div>

<style>
	.group {
		width: fit-content;
		max-width: 100%;
		padding: 1.1rem 1.25rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	h2 {
		margin: 0 0 0.85rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
</style>
