---
import TagList from './TagList.astro';
import Button from './Button.astro';

interface Props {
	href: string;
	title: string;
	description: string;
	image?: string;
	tags?: string[];
}

const { href, title, description, image, tags = [] } = Astro.props;
---

<article class="card">
	<div class="body">
		<h2>{title}</h2>
		<TagList tags={tags} />
		<p>{description}</p>
		<div class="footer">
			<Button href={href}>View project →</Button>
		</div>
	</div>
	{
		image && (
			<div class="media">
				<img src={image} alt={title} loading="lazy" />
			</div>
		)
	}
</article>

<style>
	.card {
		display: grid;
		grid-template-columns: 1fr 1fr;
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-text);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: clamp(1rem, 3vw, 1.75rem) clamp(1.25rem, 4vw, 2.5rem);
	}

	.footer {
		margin-top: auto;
		padding-top: 0.5rem;
	}

	.media {
		display: flex;
		align-items: center;
		padding: clamp(0.75rem, 2vw, 1.25rem);
	}

	img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border: 1px solid var(--color-border);
		border-radius: calc(var(--radius) - 4px);
		box-shadow:
			0 0 0 4px var(--color-bg),
			0 8px 24px rgb(0 0 0 / 0.45);
	}

	h2 {
		margin: 0;
		font-size: clamp(1.3rem, 3vw, 1.75rem);
		line-height: 1.25;
	}

	p {
		margin: 0;
		color: var(--color-text-muted);
	}

	@media (max-width: 760px) {
		.card {
			grid-template-columns: 1fr;
		}

		.media {
			order: -1;
			padding-bottom: 0;
		}
	}
</style>
