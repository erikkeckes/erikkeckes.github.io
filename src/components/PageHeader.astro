---
const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/blog', label: 'Blog' },
];

const socials = [
	{
		href: 'https://github.com/erikkeckes',
		label: 'GitHub',
		path: 'M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z',
	},
	{
		href: 'https://www.linkedin.com/in/erik-keckes-b781b2254',
		label: 'LinkedIn',
		path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z',
	},
	{
		href: 'mailto:e.keckes8@gmail.com',
		label: 'Email',
		path: 'M2 4h20a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 2v.51l10 6.25 10-6.25V6H2Zm20 2.87-9.47 5.92a1 1 0 0 1-1.06 0L2 8.87V18h20V8.87Z',
	},
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="page-header">
	<nav class="nav">
		<ul class="nav-links">
			{
				navLinks.map(({ href, label }) => (
					<li>
						<a href={href} aria-current={isActive(href) ? 'page' : undefined}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="right">
			<ul class="socials">
			{
				socials.map(({ href, label, path }) => (
					<li>
						<a href={href} aria-label={label} title={label} target="_blank" rel="noopener noreferrer">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
								<path d={path} />
							</svg>
						</a>
					</li>
				))
			}
			</ul>
			<a href="/" class="name">Erik</a>
		</div>
	</nav>
</header>

<style>
	.page-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-top: none;
		border-radius: 0 0 var(--radius) var(--radius);
	}

	.nav {
		display: flex;
		align-items: stretch;
		justify-content: space-between;
		min-height: 3.25rem;
		padding: 0 1.5rem 0.5rem 0;
	}

	.right {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.name {
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--color-text);
	}

	ul {
		display: flex;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		color: var(--color-text-muted);
		text-decoration: none;
	}

	a:hover,
	a[aria-current='page'] {
		color: var(--color-text);
	}

	.nav-links {
		gap: 0.2rem;
	}

	.nav-links li {
		display: flex;
	}

	.nav-links a {
		display: flex;
		align-items: center;
		padding: 0 1.1rem;
		border-radius: 0 0 8px 8px;
		transition: background-color 0.15s, color 0.15s;
	}

	.nav-links a:hover {
		background: var(--color-nav-hover);
		color: var(--color-nav-hover-text);
	}

	.nav-links li:first-child a {
		border-bottom-left-radius: var(--radius);
	}

	.nav-links a[aria-current='page'] {
		background: var(--color-nav-active);
		box-shadow: 0 4px 12px color-mix(in srgb, var(--color-nav-active) 45%, transparent);
		color: var(--color-nav-active-text);
		font-weight: 600;
	}

	.socials a {
		display: flex;
	}

	@media (max-width: 640px) {
		.socials {
			display: none;
		}
	}
</style>
