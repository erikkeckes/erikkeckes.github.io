---
import TagList from './TagList.astro';
import Button from './Button.astro';

interface Props {
	href: string;
	title: string;
	description: string;
	date: Date;
	image?: string;
	tags?: string[];
}

const { href, title, description, date, image, tags = [] } = Astro.props;
const formattedDate = date.toLocaleDateString('en-GB', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
});
---

<div class="wrapper">
	<article class:list={['card', { 'has-image': image }]}>
		{image && <img src={image} alt={title} loading="lazy" />}
		<div class="body">
			<h2>{title}</h2>
			<TagList tags={tags} />
			<p>{description}</p>
			<div class="footer">
				<time datetime={date.toISOString()}>{formattedDate}</time>
				<Button href={href}>Read more →</Button>
			</div>
		</div>
	</article>
</div>

<style>
	/* Layout responds to the card's own width, so it works in both 1- and 2-column grids */
	.wrapper {
		container-type: inline-size;
		height: 100%;
	}

	.card {
		display: grid;
		grid-template-columns: 1fr;
		height: 100%;
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-text);
	}

	img {
		display: block;
		width: 100%;
		height: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1rem 1.25rem 1.25rem;
	}

	.has-image .body {
		border-top: 1px solid var(--color-border);
	}

	.footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: auto;
		padding-top: 0.5rem;
	}

	time {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	h2 {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.3;
	}

	p {
		margin: 0;
		color: var(--color-text-muted);
	}

	@container (min-width: 480px) {
		img {
			width: 75%;
		}
		
		.has-image {
			grid-template-columns: 2fr 3fr;
		}

		.has-image img {
			aspect-ratio: auto;
			min-height: 100%;
		}

		.has-image .body {
			border-top: none;
			border-left: 1px solid var(--color-border);
		}
	}
</style>
