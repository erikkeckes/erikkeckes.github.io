---
// GPU-rendered hero scene (WebGPU, falling back to WebGL 2). Rendering lives in src/scripts/webgpu/
interface Props {
	name?: string;
	tagline?: string;
}

// Placeholders until the real copy is decided
const { name = 'Erik Kečkéš', tagline = 'Graphics & Engine programmer' } = Astro.props;
---

<section class="hero-3d" id="scene" aria-label="3D scene">
	<canvas class="canvas" aria-hidden="true" title="Drag to rotate the view"></canvas>
	<div class="intro">
		<h1 class="name">{name}</h1>
		<p class="tagline">{tagline}</p>
	</div>
	<p class="fallback" hidden>Your browser doesn't support WebGPU or WebGL 2, so the 3D scene can't be shown.</p>
</section>

<script>
	import { createHeroRenderer } from '../../scripts/webgpu/renderer';

	const scene = document.querySelector<HTMLElement>('#scene');
	const canvas = scene?.querySelector<HTMLCanvasElement>('canvas');
	const fallback = scene?.querySelector<HTMLElement>('.fallback');

	if (canvas) {
		createHeroRenderer(canvas)
			.then((renderer) => {
				if (!renderer) throw new Error('WebGPU and WebGL 2 unavailable');
				scene?.classList.add('is-ready');
			})
			.catch((error) => {
				console.info('Hero scene disabled:', error);
				canvas.remove();
				fallback?.removeAttribute('hidden');
			});
	}
</script>

<style>
	.hero-3d {
		position: relative;
		height: clamp(320px, 70vh, 720px);
		overflow: hidden;
	}

	.canvas {
		display: block;
		width: 100%;
		height: 100%;
		opacity: 0;
		transition: opacity 0.6s ease;
	}

	.is-ready .canvas {
		opacity: 1;
	}

	/* Drag to orbit. On touch, vertical swipes still scroll the page */
	.is-ready .canvas {
		cursor: grab;
		touch-action: pan-y;
	}

	.is-ready .canvas.is-dragging {
		cursor: grabbing;
	}

	/* Centred over the black hole; clicks pass through so the scene can still be dragged */
	.intro {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 1.5rem;
		text-align: center;
		pointer-events: none;
	}

	.name {
		margin: 0;
		font-size: clamp(2rem, 6vw, 4rem);
		line-height: 1.1;
		color: var(--color-text);
		text-shadow: 0 2px 24px var(--color-bg), 0 0 8px var(--color-bg);
	}

	.tagline {
		margin: 0;
		font-size: clamp(1rem, 2.2vw, 1.35rem);
		color: var(--color-tag-line);
		text-shadow: 0 1px 12px var(--color-bg), 0 0 6px var(--color-bg);
	}

	/* Sits under the intro text when the scene can't render */
	.fallback {
		position: absolute;
		inset: auto 0 0;
		margin: 0;
		padding: 1.5rem;
		color: var(--color-text-muted);
		text-align: center;
	}

	.fallback[hidden] {
		display: none;
	}
</style>
