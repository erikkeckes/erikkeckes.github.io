---
interface Props {
	id: string;
	title: string;
	subtitle?: string;
}

const { id, title, subtitle } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
	<header class="heading">
		<h2 id={`${id}-title`}>{title}</h2>
		{subtitle && <p>{subtitle}</p>}
	</header>
	<slot />
	{
		Astro.slots.has('footer') && (
			<div class="footer">
				<slot name="footer" />
			</div>
		)
	}
</section>

<style>
	.section {
		--section-pad-x: clamp(1rem, 3vw, 1.5rem);
		padding: clamp(2.5rem, 6vw, 4.5rem) var(--section-pad-x);
	}

	.heading {
		margin-bottom: clamp(1.25rem, 3vw, 2rem);
	}

	h2 {
		margin: 0;
		font-size: clamp(1.6rem, 4vw, 2.25rem);
		line-height: 1.2;
	}

	.heading p {
		margin: 0.4rem 0 0;
		color: var(--color-text-muted);
	}

	.footer {
		display: flex;
		justify-content: center;
		margin-top: clamp(1.5rem, 4vw, 2.5rem);
	}
</style>
