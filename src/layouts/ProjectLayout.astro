---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Media from '../components/Media.astro';
import InfoGroup from '../components/InfoGroup.astro';
import TagList from '../components/TagList.astro';
import SocialFooter from '../components/SocialFooter.astro';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { data } = Astro.props.project;

const heroSrc = data.video ?? data.image;

const teamLabel =
	data.team === 'Team' && data.teamSize ? `Team of ${data.teamSize}` : data.team;

const details = [data.type, teamLabel, data.role].filter((value): value is string => Boolean(value));
---

<BaseLayout title={`${data.title} | Erik Keckes`} description={data.description}>
	<article class="project">
		{heroSrc && <Media src={heroSrc} alt={data.title} poster={data.video ? data.image : undefined} />}

		<hr class="divider" />

		<h1>{data.title}</h1>

		{
			(details.length > 0 || data.technologies.length > 0) && (
				<section class="info" aria-label="Project details">
					{details.length > 0 && (
						<InfoGroup title="Project">
							<ul class="details">
								{details.map((value) => (
									<li>{value}</li>
								))}
							</ul>
						</InfoGroup>
					)}
					{data.technologies.length > 0 && (
						<InfoGroup title="Technologies">
							<TagList tags={data.technologies} />
						</InfoGroup>
					)}
				</section>
			)
		}

		<div class="prose">
			<slot />
		</div>
	</article>

	<SocialFooter />
</BaseLayout>

<style>
	.project {
		max-width: 1000px;
		margin: 0 auto;
		padding: clamp(1rem, 3vw, 2rem) clamp(1rem, 3vw, 1.5rem) clamp(2.5rem, 6vw, 4rem);
	}

	.divider {
		height: 2px;
		margin: clamp(1.5rem, 4vw, 2.5rem) 0;
		background: var(--color-primary);
		border: 0;
	}

	h1 {
		margin: 0;
		font-size: clamp(1.8rem, 5vw, 2.6rem);
		line-height: 1.15;
	}

	/* Info groups sized to their content, wrapping onto new lines when needed */
	.info {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: stretch;
		gap: 1rem;
		margin: clamp(1.25rem, 3vw, 2rem) 0 clamp(1.5rem, 4vw, 2.5rem);
	}

	.details {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-weight: 600;
	}
</style>
