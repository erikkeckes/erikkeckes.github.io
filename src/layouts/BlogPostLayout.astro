---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import InfoGroup from '../components/InfoGroup.astro';
import TagList from '../components/TagList.astro';
import SocialFooter from '../components/SocialFooter.astro';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { data } = Astro.props.post;
---

<BaseLayout title={`${data.title} | Erik Keckes`} description={data.description}>
	<article class="entry">
		<h1>{data.title}</h1>

		{
			data.technologies.length > 0 && (
				<div class="info">
					<InfoGroup title="Technologies">
						<TagList tags={data.technologies} />
					</InfoGroup>
				</div>
			)
		}

		<div class="prose">
			<slot />
		</div>
	</article>

	<SocialFooter />
</BaseLayout>

<style>
	.entry {
		max-width: 800px;
		margin: 0 auto;
		padding: 1.5rem 1.5rem clamp(2.5rem, 6vw, 4rem);
	}

	h1 {
		margin: 0;
		font-size: clamp(1.8rem, 5vw, 2.6rem);
		line-height: 1.15;
	}

	.info {
		display: flex;
		justify-content: center;
		margin: clamp(1.25rem, 3vw, 2rem) 0 clamp(1.5rem, 4vw, 2.5rem);
	}
</style>
